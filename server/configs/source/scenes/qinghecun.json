  "dialogues": {
    "prologue_hebo": [
      {
        "speaker": "何伯",
        "text": "孩子，你终于回来了……村子遭了难，你妹妹阿璇被那些余孽掳走了。"
      },
      {
        "speaker": "何伯",
        "text": "他们往临渊镇方向去了。你安葬族人后，就沿着这条路去寻她吧。"
      },
      {
        "speaker": "何伯",
        "text": "记住，江湖险恶，先学会走动与对话，莫要逞强。"
      }
    ],
    "tieshan": [
      {
        "speaker": "教头·铁山",
        "text": "江湖第一步，先把手练硬！老夫这木桩人随你打。",
        "options": [
          {
            "text": "切磋木桩人",
            "action": "battle:muzhuang"
          },
          {
            "text": "4v4 演练（感电 / 反伤）",
            "action": "battle:drill"
          },
          {
            "text": "改日再来",
            "action": ""
          }
        ]
      }
    ],
    "door_dazhai": [
      {
        "speaker": "村中大宅",
        "text": "门扉虚掩，堂前落了薄灰。桌上还摆着未收的茶盏，像是主人匆匆离席。"
      },
      {
        "speaker": "村中大宅",
        "text": "后院通向地窖的木梯隐在暗处。",
        "options": [
          {
            "text": "下地窖看看",
            "action": "toast:地窖场景尚未开放"
          },
          {
            "text": "退出",
            "action": ""
          }
        ]
      }
    ],
    "door_dongtian": [
      {
        "speaker": "东田小院",
        "text": "院里晒着药草，竹篱外是成片的稻田。屋主不在，只留一壶凉茶。"
      }
    ],
    "door_nanshe": [
      {
        "speaker": "南舍",
        "text": "低矮的土屋，灶台尚有余温。墙上挂着一件旧蓑衣。"
      }
    ]
  },
